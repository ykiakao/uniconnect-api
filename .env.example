NODE_ENV=development
PORT=3333
HOST=0.0.0.0
API_VERSION=v1
ACADEMIC_PROVIDER=disabled
# Valores permitidos: disabled, demo, native. Selecao somente no servidor.
ACADEMIC_DEMO_TENANT_SLUG=edukmais
APP_ORIGIN=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
SUPABASE_URL=https://your-project-ref.supabase.co
# Preencha as chaves apenas no ambiente local autorizado; nunca versione segredos.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PLATFORM_ADMIN_AUTH_USER_IDS=
# Defina URLs HTTPS autorizadas no servidor e configure templates Auth com TokenHash.
# AUTH_RECOVERY_REDIRECT_URL=https://frontend.example.invalid/password/reset
# AUTH_INVITE_REDIRECT_URL=https://frontend.example.invalid/accounts/activate
# Formato: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
SUPABASE_DB_URL=
SUPABASE_DB_SSL_MODE=verify-full
SUPABASE_DB_CA_FILE=
# Sem senhas padrao. Setup exige STUDENT, TEACHER, COORDINATOR e OWNER.
# Seed demo exige UNIVERSITY, TEACHER e STUDENT. Use valores privados definidos pelo operador.
DEMO_STUDENT_PASSWORD=
DEMO_TEACHER_PASSWORD=
DEMO_COORDINATOR_PASSWORD=
DEMO_OWNER_PASSWORD=
DEMO_UNIVERSITY_PASSWORD=

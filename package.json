{
  "name": "uniconnect-api",
  "version": "0.1.0",
  "private": true,
  "description": "API backend SaaS para o UniConnect.",
  "main": "dist/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "setup:supabase": "tsx scripts/setup-supabase.ts",
    "migrations:homologation:offline": "node scripts/homologation-migrations.cjs --offline",
    "test:homologation-invoker": "node --test scripts/tests/homologation-migrations.test.cjs",
    "seed:demo": "tsx scripts/seed-demo-university.ts",
    "test:auth": "tsx scripts/auth-smoke.ts",
    "test:academic": "tsx scripts/academic-smoke.ts",
    "test:invites": "tsx scripts/invite-smoke.ts",
    "test:seed-demo": "tsx scripts/seed-demo-smoke.ts",
    "test:academic-build": "node scripts/academic-production-smoke.cjs",
    "test:security-db": "node scripts/security-database-test.cjs",
    "test:attachments": "jest src/modules/attachments --runInBand",
    "test:attachments:db": "node --test scripts/tests/academic-attachments-db.test.cjs",
    "test:attachments:cleanup": "node --test scripts/tests/academic-attachments-cleanup.test.cjs scripts/tests/academic-pdf-budget.test.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "test:push": "jest src/modules/push --runInBand"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "5.12.0",
    "firebase-admin": "14.5.1",
    "helmet": "^8.0.0",
    "pdf-lib": "1.17.1",
    "pg": "^8.21.0",
    "sharp": "0.35.5",
    "ws": "^8.21.0",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "fflate": "0.8.3",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "firebase-admin": {
      "@firebase/database-compat": "2.1.7"
    }
  }
}
